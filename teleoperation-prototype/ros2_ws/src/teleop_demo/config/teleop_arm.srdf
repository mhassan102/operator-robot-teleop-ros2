<?xml version="1.0" encoding="UTF-8"?>
<robot name="teleop_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="finger_left"/>
    <joint name="finger_right"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.55"/>
    <joint name="joint3" value="-1.15"/>
    <joint name="joint4" value="0.60"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <group_state name="fold" group="arm">
    <joint name="joint1" value="1.2"/>
    <joint name="joint2" value="0.35"/>
    <joint name="joint3" value="-1.70"/>
    <joint name="joint4" value="0.80"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.45"/>
    <joint name="joint3" value="-1.35"/>
    <joint name="joint4" value="0.90"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <group_state name="observe" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.20"/>
    <joint name="joint3" value="-0.70"/>
    <joint name="joint4" value="1.70"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <group_state name="pregrasp" group="arm">
    <joint name="joint1" value="0.10"/>
    <joint name="joint2" value="0.20"/>
    <joint name="joint3" value="-1.00"/>
    <joint name="joint4" value="1.40"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <group_state name="retract" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.20"/>
    <joint name="joint3" value="-1.45"/>
    <joint name="joint4" value="1.50"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>
  <group_state name="stow" group="arm">
    <joint name="joint1" value="2.50"/>
    <joint name="joint2" value="0.40"/>
    <joint name="joint3" value="-2.20"/>
    <joint name="joint4" value="1.40"/>
    <joint name="joint5" value="0.80"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <end_effector name="tool" parent_link="tool0" group="gripper" parent_group="arm"/>

  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="finger_left_link" link2="finger_right_link" reason="Never"/>
  <disable_collisions link1="link6" link2="finger_left_link" reason="Never"/>
  <disable_collisions link1="link6" link2="finger_right_link" reason="Never"/>
  <!-- Coarse visual-collision boxes overlap at the home wrist pose. -->
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="tool0" reason="Never"/>
  <disable_collisions link1="link5" link2="tool0" reason="Never"/>
</robot>
